<% layout("/layouts/boilerplate") %>

    <body>
        <div class="row">

            <div class="col-8 offset-2">

                <h2>Edit your listing:</h2>

                <form action="/listings/<%= result._id %>?_method=PUT" method="post" novalidate class="needs-validation">

                    <div class="mb-3">
                        <label for="title" class="form-label">Edit Title</label>
                        <input type="text" name="title" class="form-control" value="<%= result.title %>" required>
                         <div class="invalid-feedback">Title is required</div>
                    </div>



                    <div class="mb-3">
                        <label for="des" class="form-label">Edit Description</label>
                        <textarea name="description" class="form-control" placeholder="description" rows="5" cols="50" required
                            id="des"><%= result.description %></textarea>
                             <div class="invalid-feedback">description is required</div>
                    </div>

                    <div class="mb-3">
                        <label for="image" class="form-label">Edit Image Link</label>
                        <input type="text" name="image" class="form-control" id="price" value="<%= result.image %>" required>
                        <div class="invalid-feedback">Image is required</div>
                    </div>

                    <div  class="row">

                        <div class="mb-3 col-4">
                            <label for="price" class="form-label">Edit Price</label>
                            <input type="number" name="price" class="form-control" id="price"
                                value="<%= result.price %>" required>
                                <div class="invalid-feedback">Price is required</div>
                        </div>


                        <div class="mb-3 col-8">
                            <label for="loc" class="form-label">Edit Location</label>
                            <input type="text" name="location" class="form-control" id="loc"
                                value="<%= result.location %>" required>
                                <div class="invalid-feedback">Location is required</div>
                        </div>

                    </div>

                    <div class="mb-3">
                        <label for="con" class="form-label">Edit Country</label>
                        <input type="text" name="country" class="form-control" id="con" value="<%= result.country %>" required>
                        <div class="invalid-feedback">country is required</div>
                    </div>

                    <button type="submit" class="btn def-btn">Edit</button>
                </form>
            </div>

        </div>

    </body>