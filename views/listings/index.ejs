<% layout("/layouts/boilerplate") %>
<!-- <%= success %> -->
<body>

        <h3>All Listings</h3>
        <!-- <a href="/listings/new">New Listing</a> -->
        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-4">
            <% for(list of listings){ %>

                <div class="col">

                    <div class="card card-boundry h-100 card-idx" style="width: 100%; height: auto;">
                        <div class="card-body">
                            <a href="/listings/<%= list._id %>">
                                <img src="<%=list.image %>" class="card-img-top card-img-idx">
                            </a>
                            <p class="card-title">
                                <b>
                                    <%=list.title %>
                                </b>
                            </p>
                            <p class="card-text">
                                &#8377;<%= list.price !=null ? list.price.toLocaleString("en-IN") : "Price unavailable"
                                    %> / night
                            </p>
                        </div>
                    </div>

                </div>

                <% } %>
        </div>
    </body>