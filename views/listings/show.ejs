<% layout("/layouts/boilerplate") %>

    <body>
        <div class="row show">

            <div class="col-8 offset-2">

                <h2 style="color: #000000c1;">
                    <%=result.title %>
                </h2>
                <div class="card card-boundry" style="height: auto;">
                    <img src="<%=result.image %>" class="card-img-top show-img" style="height: auto;">
                    <br>
                    <div class="card-body">
                        Owner: <b><i class="owner">
                                <%= result.owner.username %>
                            </i></b>
                        <br><br>
                        <p class="card-text">
                            <i>
                                <%=result.description %>
                            </i>
                        </p>
                        <p>&#8377;<%= result.price !=null ? result.price.toLocaleString("en-IN") : "Price unavailable"
                                %> / night</p>
                        <span>
                            <%=result.location %>,
                        </span>
                        <span>
                            <%=result.country %>
                        </span>
                        <br>

                        <% if(currUser && currUser.username===result.owner.username) { %>
                            <br>
                            <button class="btn btn-light"><a href="/listings/<%= result._id%>/edit">edit</a></button>
                            &nbsp;&nbsp;&nbsp;&nbsp;

                            <form action="/listings/<%= result._id %>?_method=DELETE" method="post"
                                style="display: inline !important;">
                                <button type="submit" class="btn btn-danger"
                                    onclick="return confirm('Are you sure you want to delete this listing?')">Delete</button>
                            </form>

                        <% } %>
                    </div>

                    <hr>
                    <h3>Reviews</h3>

                    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-3">

                        <% for(rev of result.reviews){ %>
                            <div class="col text-center">
                                <div class="card h-100" style="width: 100%; height: auto;">
                                    <div class="card-body">
                                        <h4 class="card-title">
                                            <%= rev.rating %>/5 &#9733
                                        </h4>
                                        <p class="card-text">
                                            <%= rev.comment %> ~
                                                <i class="reviewer">
                                                    @<%= rev.reviewer.username %>
                                                </i>
                                        </p>
                                        <br>
                                        <% if(currUser && currUser.username===rev.reviewer.username) { %>
                                            <form
                                                action="/listings/<%= result._id %>/reviews/<%= rev._id %>?_method=DELETE"
                                                method="post">
                                                <button class="btn btn-danger">Delete</button>
                                            </form>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>

                    <br>
                    <hr>

                    <!-- *REVIEWS -->
                    <% if(currUser) { %>

                        <div class="col-6">
                            <h3>Leave a review</h3>
                            <form action="/listings/<%= result._id %>/reviews" method="post" class="needs-validation"
                                novalidate>
                                <div class="mb-3">
                                    <label for="rating" class="form-label">rating</label>
                                    <div class="form-range">
                                        <input type="range" name="rating" class="form-range-input" id="rating" min="1"
                                            max="5" step="1" required>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label for="comment">Write comment</label>
                                    <textarea name="comment" placeholder="write comment" rows="5" cols="50" id="comment"
                                        class="form-control" required></textarea>
                                    <div class="invalid-feedback">Fill this field</div>
                                </div>

                                <button type="submit" class="btn btn-outline-dark">Submit</button>
                            </form>

                            <br>
                        </div>

                    <% } %>
                </div>


            </div>

        </div>
    </body>