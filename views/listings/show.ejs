<% layout("/layouts/boilerplate") %>

<div class="container my-4 mb-5">
    <!-- Listing heading -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div>
            <h2 class="fw-bold mb-1"><%= result.title %></h2>
            <p class="text-secondary mb-0">
                <i class="fa-solid fa-location-dot me-1"></i>
                <%= result.location %>, <%= result.country %>
            </p>
        </div>

        <% if (currUser && currUser.username === result.owner.username) { %>
            <div class="d-flex gap-2">
                <a href="/listings/<%= result._id %>/edit"
                   class="btn btn-outline-dark rounded-pill px-3">
                    <i class="fa-solid fa-pen me-1"></i> Edit
                </a>

                <form action="/listings/<%= result._id %>?_method=DELETE"
                      method="post"
                      onsubmit="return confirm('Are you sure you want to delete this listing?')">
                    <button type="submit" class="btn btn-danger rounded-pill px-3">
                        <i class="fa-solid fa-trash me-1"></i> Delete
                    </button>
                </form>
            </div>
        <% } %>
    </div>

    <!-- Main image -->
    <div class="mb-4">
        <img
            src="<%= result.image %>"
            alt="<%= result.title %>"
            class="w-100 rounded-4"
            style="height: 400px; object-fit: cover;"
        >
    </div>

    <div class="row g-5">
        <!-- Listing details -->
        <div class="col-12 col-lg-7">
            <div class="border-bottom pb-4 mb-4">
                <h4 class="fw-semibold mb-2">
                    Hosted by <%= result.owner.username %>
                </h4>
                <p class="text-secondary mb-0">
                    <i class="fa-solid fa-house me-2"></i>
                    Your place to stay in <%= result.location %>
                </p>
            </div>

            <div class="border-bottom pb-4 mb-4">
                <h5 class="fw-bold mb-3">About this place</h5>
                <p class="text-secondary lh-lg mb-0"><%= result.description %></p>
            </div>

            <div class="border-bottom pb-4 mb-4">
                <h5 class="fw-bold mb-3">Location</h5>
                <p class="mb-1">
                    <i class="fa-solid fa-location-dot me-2"></i>
                    <%= result.location %>, <%= result.country %>
                </p>
            </div>

            <!-- Reviews -->
            <div class="pt-2">
                <h4 class="fw-bold mb-3">
                    <i class="fa-solid fa-star me-2"></i>
                    Guest reviews
                    <span class="text-secondary fs-6">(<%= result.reviews.length %>)</span>
                </h4>

                <% if (result.reviews.length === 0) { %>
                    <p class="text-secondary">No reviews yet. Be the first to leave one!</p>
                <% } else { %>
                    <div class="row row-cols-1 row-cols-md-2 g-3">
                        <% for (let rev of result.reviews) { %>
                            <div class="col">
                                <div class="card h-100 rounded-4">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <h6 class="fw-bold mb-1">
                                                    @<%= rev.reviewer.username %>
                                                </h6>
                                                <span class="text-warning">
                                                    <% for (let i = 0; i < rev.rating; i++) { %>
                                                        <i class="fa-solid fa-star"></i>
                                                    <% } %>
                                                </span>
                                                <span class="text-secondary small">
                                                    <%= rev.rating %>/5
                                                </span>
                                            </div>

                                            <% if (currUser && currUser.username === rev.reviewer.username) { %>
                                                <form
                                                    action="/listings/<%= result._id %>/reviews/<%= rev._id %>?_method=DELETE"
                                                    method="post"
                                                    onsubmit="return confirm('Delete your review?')">
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger border-0"
                                                            aria-label="Delete review">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>
                                            <% } %>
                                        </div>

                                        <p class="mb-0 text-secondary"><%= rev.comment %></p>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Price and review form -->
        <div class="col-12 col-lg-5">
            <div class="card rounded-4 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-1">
                        ₹<%= result.price != null
                            ? result.price.toLocaleString("en-IN")
                            : "Price unavailable" %>
                        <span class="fs-6 fw-normal text-secondary">/ night</span>
                    </h4>

                    <hr>

                    <p class="mb-2">
                        <i class="fa-solid fa-location-dot me-2"></i>
                        <%= result.location %>, <%= result.country %>
                    </p>

                    <p class="text-secondary small mb-0">
                        Listed by <strong><%= result.owner.username %></strong>
                    </p>
                </div>
            </div>

            <% if (currUser) { %>
                <div class="card rounded-4 shadow-sm">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-1">Leave a review</h4>
                        <p class="text-secondary small mb-4">
                            Share your experience with other travellers.
                        </p>

                        <form action="/listings/<%= result._id %>/reviews"
                              method="post"
                              class="needs-validation"
                              novalidate>

                            <div class="mb-4">
                                <label class="form-label fw-semibold d-block">Your rating</label>

                                <div class="star-rating">
                                    <input type="radio" name="rating" id="star5" value="5" required>
                                    <label for="star5"><i class="fa-solid fa-star"></i></label>

                                    <input type="radio" name="rating" id="star4" value="4">
                                    <label for="star4"><i class="fa-solid fa-star"></i></label>

                                    <input type="radio" name="rating" id="star3" value="3">
                                    <label for="star3"><i class="fa-solid fa-star"></i></label>

                                    <input type="radio" name="rating" id="star2" value="2">
                                    <label for="star2"><i class="fa-solid fa-star"></i></label>

                                    <input type="radio" name="rating" id="star1" value="1">
                                    <label for="star1"><i class="fa-solid fa-star"></i></label>
                                </div>
                                <div class="invalid-feedback">Please select a rating.</div>
                            </div>

                            <div class="mb-3">
                                <label for="comment" class="form-label fw-semibold">
                                    Your comment
                                </label>
                                <textarea
                                    name="comment"
                                    id="comment"
                                    class="form-control rounded-3"
                                    rows="4"
                                    placeholder="What did you like about this place?"
                                    required></textarea>
                                <div class="invalid-feedback">
                                    Please write a comment.
                                </div>
                            </div>

                            <button type="submit" class="btn btn-dark rounded-pill w-100 mt-2">
                                Submit review
                            </button>
                        </form>
                    </div>
                </div>
            <% } else { %>
                <div class="card rounded-4">
                    <div class="card-body p-4 text-center">
                        <i class="fa-regular fa-star fs-3 mb-2"></i>
                        <h5 class="fw-bold">Stayed here?</h5>
                        <p class="text-secondary small">Log in to share your experience.</p>
                        <a href="/login" class="btn btn-outline-dark rounded-pill px-4">
                            Log in to review
                        </a>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>