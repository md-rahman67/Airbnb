<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= statusCode %> | Oops, Lost Your Way!</title>

    <!-- Include Bootstrap and Font Awesome if not already loaded -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
          rel="stylesheet">
</head>

<body class="bg-body-tertiary">

    <main class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
        <div class="card border-0 shadow rounded-5 text-center p-4 p-md-5 w-100"
             style="max-width: 520px;">

            <div class="mb-3">
                <span class="badge rounded-pill text-bg-danger px-3 py-2">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    A little detour!
                </span>
            </div>

            <div class="display-1 mb-3" aria-hidden="true">🧭</div>

            <h1 class="display-2 fw-bold text-danger mb-0">
                <%= statusCode %>
            </h1>

            <h2 class="fw-bold mt-3">Oops! You're off the map.</h2>

            <p class="text-secondary mt-2 mb-4">
                Looks like our travel plans hit a tiny bump.
                <br>
                <span class="fw-medium text-body"><%= message %></span>
            </p>

            <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                <a href="/listings" class="btn btn-danger rounded-pill px-4 py-2">
                    <i class="fa-solid fa-compass me-2"></i>
                    Explore listings
                </a>

                <button type="button"
                        class="btn btn-outline-dark rounded-pill px-4 py-2"
                        onclick="history.back()">
                    <i class="fa-solid fa-arrow-left me-2"></i>
                    Go back
                </button>
            </div>

            <hr class="my-4">

            <p class="small text-secondary mb-0">
                <i class="fa-solid fa-suitcase-rolling me-1"></i>
                Don't worry, every great trip has a detour.
            </p>
        </div>
    </main>

</body>
</html>